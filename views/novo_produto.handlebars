<div class="card col-md-6 offset-md-3 p-4 shadow-sm">
    <h3 class="mb-4">Cadastrar Novo Material para o Estoque</h3>
    
    <form action="/produtos/criar" method="POST">
        <div class="mb-3">
            <label class="form-label">Código do Item</label>
            <input type="text" name="cod_item" class="form-control" placeholder="Ex: 050887" required>
        </div>
        
        <div class="mb-3">
            <label class="form-label">Nome do Produto</label>
            <input type="text" name="nome_produto" class="form-control" placeholder="Ex: Caderno Universitário" required>
        </div>

        <div class="mb-3">
            <label class="form-label">Marca</label>
            <input type="text" name="marca" class="form-control" placeholder="Ex: Credeal" required>
        </div>

        <div class="mb-3">
            <label class="form-label">Categoria</label>
            <input type="text" name="categoria" class="form-control" placeholder="Ex: Cadernos e Blocos" required>
        </div>

        <div class="row">
            <div class="col mb-3">
                <label class="form-label">Quantidade Atual</label>
                <input type="number" name="quantidade_atual" class="form-control" min="0" value="0" required>
            </div>
            <div class="col mb-3">
                <label class="form-label">Preço</label>
                <input type="number" name="preco" class="form-control" step="0.01" min="0" placeholder="0.00" required>
            </div>
        </div>

        <div class="d-flex justify-content-between mt-3">
            <a href="/" class="btn btn-secondary">Voltar</a>
            <button type="submit" class="btn btn-primary">Salvar no Estoque</button>
        </div>
    </form>
</div>