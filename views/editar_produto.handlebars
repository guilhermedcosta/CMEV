<div class="card col-md-6 offset-md-3 p-4 shadow-sm">
    <h3 class="mb-4">Editar Material no Estoque</h3>
    
    <form action="/produtos/atualizar" method="POST">
        <input type="hidden" name="id" value="{{produto.id}}">

        <div class="mb-3">
            <label class="form-label">Código do Item</label>
            <input type="text" name="cod_item" class="form-control" value="{{produto.cod_item}}" required>
        </div>
        
        <div class="mb-3">
            <label class="form-label">Nome do Produto</label>
            <input type="text" name="nome_produto" class="form-control" value="{{produto.nome_produto}}" required>
        </div>

        <div class="mb-3">
            <label class="form-label">Marca</label>
            <input type="text" name="marca" class="form-control" value="{{produto.marca}}" required>
        </div>

        <div class="mb-3">
            <label class="form-label">Categoria</label>
            <input type="text" name="categoria" class="form-control" value="{{produto.categoria}}" required>
        </div>

        <div class="row">
            <div class="col mb-3">
                <label class="form-label">Quantidade Atual</label>
                <input type="number" name="quantidade_atual" class="form-control" min="0" value="{{produto.quantidade_atual}}" required>
            </div>
            <div class="col mb-3">
                <label class="form-label">Preço</label>
                <input type="number" name="preco" class="form-control" step="0.01" min="0" value="{{produto.preco}}" required>
            </div>
        </div>

        <div class="d-flex justify-content-between mt-3">
            <a href="/" class="btn btn-secondary">Voltar</a>
            <button type="submit" class="btn btn-primary">Atualizar</button>
        </div>
    </form>
</div>
