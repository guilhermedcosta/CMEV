<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar Produto</title>
</head>
<body>
    <main>
        <div>
            <h3>Editar Material no Estoque</h3>

            <form action="/produtos/atualizar" method="POST">
                <input type="hidden" name="id" value="{{produto.id}}">

                <div>
                    <label>Código do Item</label>
                    <input type="text" name="cod_item" maxlength="6" value="{{produto.cod_item}}" required>
                </div>

                <div>
                    <label>Nome do Produto</label>
                    <input type="text" name="nome_produto" value="{{produto.nome_produto}}" required>
                </div>

                <div>
                    <label>Marca</label>
                    <input type="text" name="marca" value="{{produto.marca}}" required>
                </div>

                <div>
                    <label>Categoria</label>
                    <input type="text" name="categoria" value="{{produto.categoria}}" required>
                </div>

                <div>
                    <div>
                        <label>Quantidade Atual</label>
                        <input type="number" name="quantidade_atual" min="0" value="{{produto.quantidade_atual}}" required>
                    </div>
                    <div>
                        <label>Preço</label>
                        <input type="number" name="preco" step="0.01" min="0" value="{{produto.preco}}" required>
                    </div>
                </div>

                <div>
                    <a href="/produtos">Voltar</a>
                    <button type="submit">Atualizar</button>
                </div>
            </form>
        </div>
    </main>
</body>
</html>
