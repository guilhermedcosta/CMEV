<h1>Novo Pedido</h1>

<form action="/pedidos" method="POST">

<label>Setor</label>

<br>

<input
type="text"
name="setor"
required>

<br><br>

<label>Material</label>

<br>

<input
type="text"
name="material"
required>

<br><br>

<label>Quantidade</label>

<br>

<input
type="number"
name="quantidade"
required>

<br><br>

<button type="submit">

Salvar Pedido

</button>

</form>