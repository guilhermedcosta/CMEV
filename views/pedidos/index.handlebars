<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Lista de Pedidos</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 40px; }
        table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        th, td { border: 1px solid #ddd; padding: 12px; text-align: left; }
        th { background-color: #f4f4f4; }
        .btn-novo { background-color: #28a745; color: white; padding: 10px 15px; text-decoration: none; border-radius: 4px; }
        .btn-editar { background-color: #007bff; color: white; padding: 5px 10px; text-decoration: none; border-radius: 4px; margin-right: 5px; }
        .btn-excluir { background-color: #dc3545; color: white; padding: 6px 10px; border: none; border-radius: 4px; cursor: pointer; }
    </style>
</head>
<body>

    <h1>Gerenciamento de Pedidos</h1>
    
    <a href="/pedidos/novo" class="btn-novo">Cadastrar Novo Pedido</a>

    <table>
        <thead>
            <tr>
                <th>Código</th>
                <th>Setor</th>
                <th>Material</th>
                <th>Quantidade</th>
                <th>Categoria</th> <th>Marca</th>     <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            {{#each pedidos}}
            <tr>
                <td>{{this.cod_item}}</td>
                <td>{{this.setor}}</td>
                <td>{{this.material}}</td>
                <td>{{this.quantidade}}</td>
                <td>{{this.categoria}}</td> <td>{{this.marca}}</td>     <td>
                    <a href="/pedidos/editar/{{this.cod_item}}" class="btn-editar">Editar</a>

                    <form action="/pedidos/excluir" method="POST" style="display:inline;">
                        <input type="hidden" name="cod_item" value="{{this.cod_item}}">
                        <button type="submit" class="btn-excluir" onclick="return confirm('Excluir pedido?')">
                            Excluir
                        </button>
                    </form>
                </td>
            </tr>
            {{/each}}
        </tbody>
    </table>

</body>
</html>