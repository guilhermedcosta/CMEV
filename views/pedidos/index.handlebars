<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pedidos</title>
</head>
<body>
    <table>
      <tr>
        <th>ID</th>
        <th>Setor</th>
        <th>Material</th>
        <th>Quantidade</th>
      </tr>

      {{#each pedidos}}

      <tr>

        <td>{{this.id}}</td>
        <td>{{this.setor}}</td>
        <td>{{this.material}}</td>
        <td>{{this.quantidade}}</td>
      </tr>
      {{/each}}
    </table>
</body>
</html>