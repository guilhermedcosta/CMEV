<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cadastro de Usuários</title>
</head>
<body>
    <h1>Entrar</h1>

<form action="/salvar" method="POST">

    <label>CPF</label><br>
    <input type="text" name="cpf"  placeholder="Ex: 123.456.789-10" maxlength="14" minlength="14"><br><br>

    <label>Senha</label><br>
    <input type="password" name="senha" minlength="6" maxlength="15"><br><br>

    <button>Cadastrar</button>

</form>

<a href="/usuarios">Ver usuários</a>
</body>
</html>