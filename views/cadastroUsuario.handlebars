<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cadastro de Usuários</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <h1>Entrar</h1>

<form action="/salvar" method="POST">

    <label for="cpf">CPF</label><br>
    <input id="cpf" type="text" name="cpf" placeholder="Ex: 123.456.789-10" maxlength="14" minlength="14" required><br><br>

    <label for="senha">Senha</label><br>
    <input id="senha" type="password" name="senha" minlength="6" maxlength="15" required><br><br>

    <button type="submit">Cadastrar</button>

</form>

<a href="/usuarios">Ver usuários</a>
</body>
</html>