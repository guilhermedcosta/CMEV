<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar Users</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <h1>Editar Usuário</h1>

<form action="/editar" method="POST">

<input type="hidden" name="id" value="{{usuario.id}}">

<label for="cpf">CPF</label><br>
<input id="cpf" type="text" name="cpf" value="{{usuario.cpf}}" placeholder="Ex: 123.456.789-10" maxlength="14" minlength="14" required><br><br>

<label for="senha">Senha</label><br>
<input id="senha" type="password" name="senha" value="{{usuario.senha}}" maxlength="15" minlength="6" required><br><br>

<button type="submit">Salvar</button>

</form>
</body>
</html>